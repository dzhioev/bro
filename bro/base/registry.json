{
  "brog": {
    "description": "Task tracker backend configuration"
  },
  "trails": {
    "description": "Trail storage backend configuration"
  },
  "trails_tokens": {
    "description": "Bearer tokens accepted by a trails server"
  },
  "openai": {
    "description": "OpenAI API credentials"
  },
  "anthropic": {
    "description": "Anthropic API credentials"
  },
  "claude_code": {
    "description": "Claude Code OAuth token",
    "install": {
      "env": {
        "CLAUDE_CODE_OAUTH_TOKEN": {"secret": "{{insert #name}}"}
      }
    }
  },
  "brave": {
    "description": "Brave Search API credentials"
  },
  "aws": {
    "description": "AWS SDK and CLI credentials",
    "install": {
      "files": {
        "aws/credentials": {"secret": "{{insert #name}}"}
      },
      "env": {
        "AWS_SHARED_CREDENTIALS_FILE": {"path": "aws/credentials"}
      }
    }
  },
  "infra": {
    "description": "Infrastructure deployment configuration"
  },
  "github": {
    "description": "GitHub API, CLI, and Git credentials",
    "install": {
      "env": {
        "GIT_CONFIG_COUNT": "3",
        "GIT_CONFIG_KEY_0": "credential.helper",
        "GIT_CONFIG_VALUE_0": "",
        "GIT_CONFIG_KEY_1": "credential.helper",
        "GIT_CONFIG_VALUE_1": "!f() { echo username=x-access-token; echo \"password=$(credentials get {{insert #name}})\"; }; f",
        "GIT_CONFIG_KEY_2": "url.https://github.com/.insteadOf",
        "GIT_CONFIG_VALUE_2": "git@github.com:",
        "GH_CONFIG_DIR": {"path": "gh"},
        "GH_TOKEN": "",
        "GITHUB_TOKEN": ""
      },
      "commands": {
        "gh": {
          "env": {
            "GH_TOKEN": {"secret": "{{insert #name}}"}
          }
        }
      }
    }
  }
}
