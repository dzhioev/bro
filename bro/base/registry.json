{
  "brog": {"sources": [{"file": "brog.json"}]},
  "trails": {"sources": [{"file": "trails.json"}]},
  "trails_tokens": {"sources": [{"file": "trails_tokens.json"}]},
  "openai": {"sources": [{"file": "openai.json"}]},
  "anthropic": {"sources": [{"file": "anthropic.json"}]},
  "claude_code": {
    "sources": [{"file": "claude_code_oauth_token"}],
    "install": {"env": {"CLAUDE_CODE_OAUTH_TOKEN": {"secret": "{{insert #name}}"}}}
  },
  "brave": {"sources": [{"file": "brave.json"}]},
  "aws": {
    "sources": [{"file": "aws_credentials"}],
    "install": {
      "files": {"aws/credentials": {"secret": "{{insert #name}}"}},
      "env": {"AWS_SHARED_CREDENTIALS_FILE": {"path": "aws/credentials"}}
    }
  },
  "infra": {"sources": [{"file": "infra.json"}]},
  "github": {
    "sources": [],
    "install": {
      "env": {
        "GIT_CONFIG_COUNT": "3",
        "GIT_CONFIG_KEY_0": "credential.helper",
        "GIT_CONFIG_VALUE_0": "",
        "GIT_CONFIG_KEY_1": "credential.helper",
        "GIT_CONFIG_VALUE_1": "!f() { echo username=x-access-token; echo \"password=$(credentials get {{insert #name}})\"; }; f",
        "GIT_CONFIG_KEY_2": "url.https://github.com/.insteadOf",
        "GIT_CONFIG_VALUE_2": "git@github.com:",
        "GH_CONFIG_DIR": {"path": "gh"},
        "GH_TOKEN": "",
        "GITHUB_TOKEN": ""
      },
      "commands": {"gh": {"env": {"GH_TOKEN": {"secret": "{{insert #name}}"}}}}
    }
  }
}
