#!/usr/bin/env -S bash -e
# promote the staged token-accounting baseline once a commit lands, so the mark
# only advances after a *successful* commit (setup/claude_commit_footer.py owns
# the format + state file). best-effort: never fail or noise the commit.
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
footer="$root/setup/claude_commit_footer.py"
[ -x "$footer" ] || exit 0
"$footer" --record || true
